-- End-to-end CJK (Chinese/Japanese/Korean) search test.
--
-- pg_textsearch tokenizes both documents and queries through the index's
-- text_config, so CJK support is a matter of choosing a CJK-aware text
-- search configuration. This test pairs pg_textsearch with pg_cjk_parser
-- (https://github.com/huangjimmy/pg_cjk_parser), a 2-gram CJK parser, and
-- verifies indexing and ranked retrieval work end to end.
--
-- Requires the pg_cjk_parser extension to be installed. This test is not
-- part of the default REGRESS schedule; run it via `make test-cjk` in an
-- environment where pg_cjk_parser is available.
CREATE EXTENSION IF NOT EXISTS pg_textsearch;
CREATE EXTENSION IF NOT EXISTS pg_cjk_parser;
-- pg_cjk_parser installs only the parser support functions; register the
-- parser and a 2-gram configuration that maps CJK bigrams (token type
-- "cjk") plus the usual Latin/numeric token types.
CREATE TEXT SEARCH PARSER public.cjk_parser (
    START    = prsd2_cjk_start,
    GETTOKEN = prsd2_cjk_nexttoken,
    END      = prsd2_cjk_end,
    LEXTYPES = prsd2_cjk_lextype,
    HEADLINE = prsd2_cjk_headline);
CREATE TEXT SEARCH CONFIGURATION public.cjk_2gram (PARSER = cjk_parser);
ALTER TEXT SEARCH CONFIGURATION public.cjk_2gram
    ADD MAPPING FOR cjk, asciiword, asciihword, hword_asciipart,
        word, hword, hword_part, numword, numhword
    WITH simple;
-- CJK text is split into overlapping 2-gram tokens (deterministic).
-- COLLATE "C" keeps the ordering byte-stable across locales.
SELECT alias, token
FROM ts_debug('public.cjk_2gram', '机器学习')
WHERE alias = 'cjk'
ORDER BY token COLLATE "C";
 alias | token 
-------+-------
 cjk   | 器学
 cjk   | 学习
 cjk   | 机器
(3 rows)

CREATE TABLE cjk_docs (id int PRIMARY KEY, content text);
INSERT INTO cjk_docs VALUES
  (1, '机器学习是人工智能的一个分支'),   -- "machine learning" (full)
  (2, '数据库系统与全文检索技术'),       -- unrelated (database/retrieval)
  (3, '自然语言处理与机器翻译'),         -- shares bigram 机器 only
  (4, '機械学習と人工知能'),             -- Japanese "machine learning"
  (5, '기계 학습과 인공 지능');           -- Korean "machine learning"
CREATE INDEX cjk_docs_bm25 ON cjk_docs USING bm25 (content)
    WITH (text_config = 'public.cjk_2gram');
NOTICE:  BM25 index build started for relation cjk_docs_bm25
NOTICE:  Using text search configuration: public.cjk_2gram
NOTICE:  Using index options: k1=1.20, b=0.75
NOTICE:  BM25 index build completed: 5 documents, avg_length=9.40
-- Force the bm25 index scan so we exercise indexed retrieval, not
-- standalone scoring.
SET enable_seqscan = off;
-- Chinese query 机器学习 (bigrams 机器/器学/学习): doc 1 matches all three,
-- doc 3 shares only 机器, so doc 1 outranks doc 3 and no other doc matches.
SELECT id, content
FROM cjk_docs
ORDER BY content <@> to_bm25query('机器学习', 'cjk_docs_bm25')
LIMIT 2;
 id |           content            
----+------------------------------
  1 | 机器学习是人工智能的一个分支
  3 | 自然语言处理与机器翻译
(2 rows)

-- Japanese query 機械学習: only doc 4 contains those kanji bigrams.
SELECT id, content
FROM cjk_docs
ORDER BY content <@> to_bm25query('機械学習', 'cjk_docs_bm25')
LIMIT 1;
 id |      content       
----+--------------------
  4 | 機械学習と人工知能
(1 row)

RESET enable_seqscan;
DROP TABLE cjk_docs;
DROP TEXT SEARCH CONFIGURATION public.cjk_2gram;
DROP TEXT SEARCH PARSER public.cjk_parser;
DROP EXTENSION pg_cjk_parser;
DROP EXTENSION pg_textsearch;
