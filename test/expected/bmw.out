-- The single-term fast path must retain the query term's frequency.
SELECT round(bm25_get_current_score()::numeric, 6) AS repeated_index_score
FROM bmw_repeat
ORDER BY content <@> 'cat cat'::bm25query LIMIT 1;
 repeated_index_score 
----------------------
            -1.438620
