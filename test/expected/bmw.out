                  'bmw_fieldnorm_idx'))::numeric, 4) AS score
FROM bmw_fieldnorm
ORDER BY content <@> to_bm25query('needle', 'bmw_fieldnorm_idx')
LIMIT 1;
 id |  score  
----+---------
  1 | -0.2280
(1 row)

SELECT id, ROUND((content <@> to_bm25query('needle pad',
                  'bmw_fieldnorm_idx'))::numeric, 4) AS score
FROM bmw_fieldnorm
ORDER BY content <@> to_bm25query('needle pad', 'bmw_fieldnorm_idx')
LIMIT 2;
