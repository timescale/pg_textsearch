    ('alpha beta'),                 -- id=2, has 2
    ('alpha'),                      -- id=3, has 1
    ('beta gamma'),                 -- id=4, has 2
    ('delta epsilon'),              -- id=5, has none
    ('alpha alpha alpha beta'),     -- id=6, high tf for alpha
    ('gamma gamma gamma gamma');    -- id=7, high tf for gamma
