CREATE FUNCTION pg_temp.first_plan_child(query text)
RETURNS text
LANGUAGE plpgsql
AS $$
DECLARE
    plan json;
BEGIN
    EXECUTE 'EXPLAIN (FORMAT JSON, COSTS OFF) ' || query INTO plan;
    RETURN plan->0->'Plan'->'Plans'->0->>'Node Type';
END
$$;
