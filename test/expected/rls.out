\set VERBOSITY terse
ALTER TABLE index_parent ENABLE ROW LEVEL SECURITY;
ERROR:  cannot enable row-level security on relation "index_parent" because descendant relation "index_child" has a BM25 index while "pg_textsearch.allow_rls" is off
