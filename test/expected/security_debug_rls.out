(1 row)
RESET client_min_messages;
RESET ROLE;
RESET enable_seqscan;
RESET pg_textsearch.log_scores;
DROP TABLE debug_rls;
DROP ROLE debug_rls_reader;
DROP EXTENSION pg_textsearch;
