(1 row)

EXECUTE bmw_long_top1('needle thread');
 id 
----
  1
(1 row)

EXECUTE bmw_long_scores('needle thread');
 scores_match 
--------------
 t
(1 row)

-- Rebuild with uncompressed blocks and check the other block-reading path.
SET pg_textsearch.compress_segments = off;
REINDEX INDEX bmw_long_documents_idx;
NOTICE:  BM25 index build started for relation bmw_long_documents_idx
NOTICE:  Using text search configuration: simple
NOTICE:  Using index options: k1=1.20, b=0.75
NOTICE:  BM25 index build completed: 4 documents, avg_length=50304.75
DO $$
BEGIN
    PERFORM bm25_spill_index('bmw_long_documents_idx');
END $$;
EXECUTE bmw_long_top1('needle');
