    SELECT id FROM ranked_boolean_docs
    WHERE body @@ '(beta | (alpha & absent)) & !padding'::tsquery
    ORDER BY body <@> to_bm25query('alpha beta', 'ranked_boolean_idx')
    LIMIT 2000
) s;
