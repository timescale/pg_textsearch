SELECT wanted.n, found.id
FROM (VALUES
    (1, 'beta & !padding'::tsquery),
    (2, 'alpha <-> beta'::tsquery),
    (3, 'padding'::tsquery),
    (4, NULL::tsquery)
) wanted(n, query)
LEFT JOIN LATERAL (
    SELECT id FROM ranked_boolean_docs WHERE body @@ wanted.query
    ORDER BY body <@> to_bm25query('alpha', 'ranked_boolean_idx')
    LIMIT 1
) found ON true
ORDER BY wanted.n;
