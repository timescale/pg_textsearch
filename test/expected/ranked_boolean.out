-- A pushed predicate must not discard the scan's LIMIT/OFFSET hint.
SELECT count(*) AS limited_matches FROM (
    SELECT id FROM ranked_boolean_docs
    WHERE body @@ 'alpha & beta'::tsquery
    ORDER BY body <@> to_bm25query('alpha', 'ranked_boolean_idx')
    LIMIT 5 OFFSET 5
) s;
