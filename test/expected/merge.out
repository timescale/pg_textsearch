--------------------------------------------------------------------------------
INSERT INTO merge_test (content) VALUES ('hello new insertion');
INSERT INTO merge_test (content) VALUES ('database transaction log');
SELECT 'Phase 3: post-merge inserts (memtable + 1 L1 segment)' AS phase;
                         phase                         
