CREATE EXTENSION pg_textsearch;
SET default_text_search_config = 'pg_catalog.simple';
SET enable_seqscan = off;
SET jit = off;
SET pg_textsearch.filtered_seed = off;
CREATE TABLE boolean_candidates (id int PRIMARY KEY, body text);
